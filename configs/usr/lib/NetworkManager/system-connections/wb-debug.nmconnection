[connection]
id=wb-debug
uuid=0f098677-2b49-4167-a534-207567b1751b
type=bridge
interface-name=dbgbr
autoconnect=true
autoconnect-slaves=1

[user]
wb.read-only=true
wb.disable-nat=true

[bridge]
stp=false

[ipv4]
address1=10.200.200.1/30
method=shared
never-default=true

[ipv6]
addr-gen-mode=stable-privacy
method=ignore

[proxy]
