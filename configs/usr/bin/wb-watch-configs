#!/bin/bash
#set -x

WATCH_FILES=( $@ )
WATCH_DIRS=( $(
	for f in "${WATCH_FILES[@]}"; do
		dirname "$f"
	done | sort -u
) )

MNT="/mnt/data"
PID_FILE="/var/run/wb-watch-configs.pid"
cleanup() {
	[[ -f "$PID_FILE" ]] && kill `cat "$PID_FILE"` 2>/dev/null
	rm -f "$PID_FILE"
}

log() {
	logger -t wb-watch-configs "$*"
}

# Keep the old destination intact until the new copy is complete and on disk.
wb_durable_copy() {
	local from=$1
	local to=$2
	local tmp="${to}.new"

	rm -rf "$tmp" || return 1
	if cp -aH "$from" "$tmp" && sync -f "$tmp" && mv -T "$tmp" "$to"; then
		return 0
	fi
	rm -rf "$tmp"
	return 1
}

log "Watched dirs: ${WATCH_DIRS[*]}"

(
	echo "$BASHPID" > "$PID_FILE"
	2>/dev/null exec inotifywait -m \
		--event close_write,moved_to \
		--format '%w%f %e' \
		"${WATCH_DIRS[@]}"
) | {
trap cleanup EXIT

while read EVENT_FILE EVENT_TYPE; do
	grep -q "$EVENT_FILE" <<<"${WATCH_FILES[@]}" || continue
	log "$EVENT_FILE was changed"
	DST="${MNT}${EVENT_FILE}"
	if ! wb_durable_copy "$EVENT_FILE" "$DST"; then
		log "Failed to copy $EVENT_FILE to $DST"
	fi
done
}
